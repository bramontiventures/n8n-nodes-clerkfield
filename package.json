{
	"name": "n8n-nodes-clerkfield",
	"version": "0.1.1",
	"description": "n8n node for Clerkfield: verify U.S. businesses against official state registries and search UCC liens by business or lender.",
	"license": "MIT",
	"homepage": "https://clerkfield.com/docs",
	"keywords": [
		"n8n-community-node-package",
		"clerkfield",
		"business-verification",
		"kyb",
		"ucc",
		"lien-search",
		"underwriting"
	],
	"author": {
		"name": "Bramonti Ventures LLC",
		"email": "hello@clerkfield.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bramontiventures/n8n-nodes-clerkfield.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ClerkfieldApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Clerkfield/Clerkfield.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
